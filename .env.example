# Postgres — used when running the API on the host (venv + uvicorn).
# docker compose overrides this for the api service to use host `db`.
DATABASE_URL=postgresql+psycopg://semantic:semantic@localhost:5434/semantic_shop

# OpenAI embeddings (used by FastAPI embed pipeline)
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Next.js → FastAPI (host browser always uses localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000
